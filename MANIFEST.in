# MANIFEST.in for lumenairy
#
# Controls which non-package files are included in the source
# distribution (sdist) produced by ``python -m build``.  Wheels are
# built from the discovered ``lumenairy*`` packages declared in
# pyproject.toml -- they do NOT include the files listed below.
#
# The intent of the entries here is to make a tarball downloaded
# from PyPI a complete reproduction of the repository: tests,
# validation suite, examples, license, and CI workflows ship with
# it.  This was added in 4.4.0 in response to a packaging audit
# (the validation/ tree previously vanished from sdist + wheel).

include README.md
include CHANGELOG.md
include LICENSE
include pyproject.toml

# v5.24.x (audit S4-20): ship the top-level reference docs in the sdist
# so a PyPI tarball is a complete reproduction of the repository (the
# stated intent below).  Pre-fix these vanished from the sdist even
# though they are the canonical convention / migration / roadmap refs
# that the code + docstrings point users at.
include CONVENTIONS.md
include Migration-Guide.md
include ROADMAP.md
include CONTRIBUTING.md
recursive-include docs *.md *.txt

# Validation suite.  MEASURED 2026-09-12 (audit 2026-09-11, V7): the tree
# holds 876 ``.py`` across 70 sub-directories, of which 624 live under
# ``validation/probe_*`` and 184 under ``validation/repro_*`` -- per-audit-round
# scratch promoted to permanent files, not part of the suite a user runs.  The
# comment here used to say "31 files with ~370 physics-fidelity tests", which
# was the 4.4.0 count; the 37 ``t_*.py`` / ``test_*.py`` entry points are the
# part of that claim that survives.  Run with ``python validation/run_all.py``
# after extracting the sdist.
recursive-include validation *.py *.md *.txt

# ... but do NOT ship the per-round probe / reproduction scratch: 808 of the
# 876 ``.py`` above, plus whatever ``.md``/``.txt`` sits beside them.  They
# reproduce one past audit finding each, they are not runnable from an
# extracted tarball (several hard-code absolute paths on the dev box), and
# they are the bulk of the sdist's validation payload.
prune validation/probe_*
prune validation/repro_*
recursive-exclude validation/probe_* *
recursive-exclude validation/repro_* *

# Unit + integration tests.
recursive-include tests *.py

# Example scripts.
recursive-include examples *.py *.md

# CI workflows (so a downstream re-spin can replay them).
recursive-include .github *.yml *.yaml

# Don't ship caches, build artefacts, or editor cruft.
global-exclude __pycache__
global-exclude *.pyc
global-exclude *.pyo
global-exclude .DS_Store
global-exclude .*.swp
prune .pytest_cache
prune **/__pycache__
prune build
prune dist
prune *.egg-info
